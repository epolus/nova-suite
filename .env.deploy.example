# ─── Nova Suite – deployment configuration ───
# For use with docker-compose.deploy.yml, which pulls published images.
# Copy to .env and fill in the three required secrets below.
#
# Generate each secret with:  openssl rand -hex 24

# ── Required ──────────────────────────────────────────────────────────────────
# Bootstrap Postgres superuser password (schema creation and Temporal setup).
POSTGRES_PASSWORD=
# Encrypts stored tenant credentials. Shared by nova-engine and nova-worker.
# Changing it after first use makes existing stored credentials undecryptable.
CREDENTIALS_MASTER_KEY=
# Authenticates internal catalog automation calls between engine and worker.
CATALOG_AUTOMATION_SHARED_KEY=

# ── Image selection ───────────────────────────────────────────────────────────
# Pin to a release for production, e.g. NOVA_TAG=0.1.0
NOVA_TAG=latest
NOVA_IMAGE=epolus/nova-suite

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=nova
POSTGRES_USER=nova_app
# Restricted runtime role used by the API and worker. Defaults to
# POSTGRES_PASSWORD; set separately to keep the roles on distinct credentials.
POSTGRES_APP_USER=nova_runtime
POSTGRES_APP_PASSWORD=
# Must match the highest applied migration.
DB_SCHEMA_VERSION=v00.01.02

# Load ~500 incidents / ~200 requests / ~80 CIs of sample data. First boot only:
# it runs while the database is initialized and is ignored afterwards.
NOVA_LOAD_DEMO_DATA=false

# ── Networking ────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
TRUST_PROXY=1

# ── Sessions ──────────────────────────────────────────────────────────────────
# RS256 keys are generated into the nova_secrets volume on first start.
JWT_EXPIRES_IN=8h
# Set false for SSO-only mode (disables the local password form and login route).
AUTH_LOCAL_LOGIN_ENABLED=true

# ── Optional: single sign-on ──────────────────────────────────────────────────
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost/api/auth/sso/callback
# OIDC_PROVIDER_NAME=Google
# OIDC_SCOPE=openid email profile

# ── Optional: email notifications ─────────────────────────────────────────────
# MAIL_NOTIFICATIONS_ENABLED=true
# MAIL_FROM=no-reply@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Optional: AI assistant ────────────────────────────────────────────────────
# AI_ENABLED=true
# AI_DEFAULT_PROVIDER=openai        # openai | azure_openai | ollama
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Optional: Redis cache ─────────────────────────────────────────────────────
# REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379

# ── Logging ───────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
