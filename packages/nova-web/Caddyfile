:3000 {
	# Proxy API requests to the backend
	handle /api/* {
		reverse_proxy nova-engine:4000
	}

	# Proxy API docs to the backend
	handle /docs* {
		reverse_proxy nova-engine:4000
	}

	root * /srv

	# Security headers for the SPA only; /api and /docs get theirs from the engine (helmet).
	# style-src needs 'unsafe-inline' for React style props rendered as HTML and the chart theme <style>.
	# img-src allows https: because knowledge articles may embed external images.
	# script-src includes a per-request nonce so Cloudflare Bot/JS Detection can attach the
	# same nonce to the inline bootstrap it injects (hashing that script is impossible —
	# the body changes every request). Our own scripts stay external under 'self'.
	@spa not path /api/* /docs*
	header @spa {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'nonce-{http.request.uuid}'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	# Hashed Vite chunks live under /assets and must 404 when missing — never
	# SPA-fallback to index.html (that makes dynamic import() fail with an
	# opaque module error after deploys). Only cache successful asset responses.
	# Caching 404s lets Cloudflare keep a blank-page poison for hours after a
	# deploy race. Extensionless paths are app routes (/assets, /assets/new,
	# /assets/:id) and fall through to the SPA.
	handle /assets/* {
		@file path_regexp "[^/]+\.[^/]+$"
		handle @file {
			@found file {path}
			handle @found {
				header Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
			handle {
				header Cache-Control "no-store"
				respond "Not Found" 404
			}
		}
		handle {
			header Cache-Control "no-cache, must-revalidate"
			try_files {path} /index.html
			file_server
		}
	}

	# index.html (and other entry files) must revalidate so open tabs pick up new chunk hashes
	@html path / /index.html /favicon.svg /boot.js
	header @html Cache-Control "no-cache, must-revalidate"

	# SPA fallback for frontend routes
	handle {
		try_files {path} /index.html
		file_server
	}
}
