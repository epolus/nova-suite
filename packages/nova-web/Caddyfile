:3000 {
	# Proxy API requests to the backend
	handle /api/* {
		reverse_proxy nova-engine:4000
	}

	# Proxy API docs to the backend
	handle /docs* {
		reverse_proxy nova-engine:4000
	}

	root * /srv

	# Hashed Vite chunks live under /assets and must 404 when missing — never
	# SPA-fallback to index.html (that makes dynamic import() fail with an
	# opaque module error after deploys). Only cache successful asset responses.
	# Caching 404s lets Cloudflare keep a blank-page poison for hours after a
	# deploy race. Extensionless paths are app routes (/assets, /assets/new,
	# /assets/:id) and fall through to the SPA.
	handle /assets/* {
		@file path_regexp "[^/]+\.[^/]+$"
		handle @file {
			@found file {path}
			handle @found {
				header Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
			handle {
				header Cache-Control "no-store"
				respond "Not Found" 404
			}
		}
		handle {
			header Cache-Control "no-cache, must-revalidate"
			try_files {path} /index.html
			file_server
		}
	}

	# index.html (and other entry files) must revalidate so open tabs pick up new chunk hashes
	@html path / /index.html /favicon.svg
	header @html Cache-Control "no-cache, must-revalidate"

	# SPA fallback for frontend routes
	handle {
		try_files {path} /index.html
		file_server
	}
}
