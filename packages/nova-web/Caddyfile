:3000 {
	# Proxy API requests to the backend
	handle /api/* {
		reverse_proxy nova-engine:4000
	}

	# Proxy API docs to the backend
	handle /docs* {
		reverse_proxy nova-engine:4000
	}

	root * /srv

	# Hashed Vite chunks must 404 when missing — never SPA-fallback to index.html
	# (that makes dynamic import() fail with an opaque module error after deploys).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html (and other entry files) must revalidate so open tabs pick up new chunk hashes
	@html path / /index.html /favicon.svg
	header @html Cache-Control "no-cache, must-revalidate"

	# SPA fallback for frontend routes
	handle {
		try_files {path} /index.html
		file_server
	}
}
